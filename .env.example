# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# Use letters and digits only in passwords (special characters break the database address).

# --- database login ---
POSTGRES_USER=bususer
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=busdb

# --- monitoring dashboard login (user name is "admin") ---
GRAFANA_PASSWORD=change-me-too

# --- front door (HTTPS) ---
# On your own computer: keep "localhost" and the high ports below.
# On a server with a public name: SITE_ADDRESS=yourname.region.cloudapp.azure.com, HTTP_PORT=80, HTTPS_PORT=443
SITE_ADDRESS=localhost
HTTP_PORT=8080
HTTPS_PORT=8443

# --- optional ---
LOG_LEVEL=INFO
SEED_DEMO_DATA=true
BACKUP_KEEP=14
